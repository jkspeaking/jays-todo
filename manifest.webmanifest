{
  "name": "Jay's To Do List",
  "short_name": "Jay's To Do",
  "description": "Jay's to-do list: lists, sections, tasks and subtasks. Works offline and syncs across devices.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#22C3B8",
  "theme_color": "#22C3B8",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
